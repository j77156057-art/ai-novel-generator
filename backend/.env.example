# 复制为 .env 后按需修改
# 默认 SQLite：零配置即可启动，首次启动自动建表（文件落在启动目录下的 novel_dev.db）。
DATABASE_URL=sqlite:///./novel_dev.db
# 需要 PostgreSQL + pgvector（生产/向量库场景）时才启用下面两行：
#   1) 先 `docker compose up -d` 起库；
#   2) 注释掉上面的 SQLite 行，取消注释下一行。
# DATABASE_URL=postgresql+psycopg2://novel:novel@localhost:5432/novel
# SEED_DIR 的相对路径按仓库根解析，不依赖启动时的工作目录。
SEED_DIR=data/seed
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
UPLOAD_MAX_BYTES=20000000

# Embedding（M2 混合检索）。provider=dashscope 时需填 key；留空自动降级本地离线兜底
EMBEDDING_PROVIDER=dashscope
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM（M4 分段生成环）。provider=dashscope|openrouter|local；未配对应 key 自动降级本地离线兜底
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_BASE_URL=

# 智谱 GLM（open.bigmodel.cn → 头像 → API Keys，形如 xxxxx.xxxxx）
# 助手问答 / 文风蒸馏默认走这里；key 只写本机 .env，不进版本库。
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# MiniMax（国内站 api.minimaxi.com → 账号管理 → 接口 Keys，形如 sk-cp-...）
# 小说正文（第 1 章起）实际是用这一路写的：MiniMax-M3.1-Flash。
# 注意：Writer 渠道以「设置 → 模型」里的角色配置为准（存在数据库里），
# 这里的 env 只在该角色还没配过时兜底，不要只改 env 就以为换成功了。
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash

# KG 批抽专用调用预算（与 Writer 完全独立，正文生成不读这两个值）。
# 默认值同时写在 config/providers.yaml 的 kg_extract 块；这里的 env 优先级更高。
# 单次抽取总预算 300s：最坏 3 次外层尝试 ≈ 15 分钟放弃（改造前沿用 960s ≈ 48 分钟）。
KG_EXTRACT_TOTAL_TIMEOUT=300
# 首字节阶段上限 120s：连上了却一个字节都不来，2 分钟内判死，不等总预算耗尽。
KG_EXTRACT_FIRST_BYTE_TIMEOUT=120
# KG 抽取的独立渠道。留空 = 跟随主渠道 LLM_PROVIDER（现有行为不变）；
# 填 zhipu = 抽取走智谱（模型链取库里 llm.zhipu_models），写正文渠道不受影响。
# 填其它未知值会直接启动报错（不静默回退主渠道）。
KG_EXTRACT_PROVIDER=

# brief 检索工具（可选）：总开关 + 无头浏览器后端（Playwright + Bing）
BRIEF_TOOL_ENABLED=false
BRIEF_TOOL_HEADLESS=true

# OpenRouter（可选：免费模型）。用法：LLM_PROVIDER=openrouter 并填 OPENROUTER_API_KEY
# 默认关闭 reasoning（续写要吞吐）。2026-10 实测 15 款 :free，可用的按速度：
#   apodex/apodex-1.1-mini:free             ~2.5s  中文干净（默认，适合分段循环生成）
#   nvidia/nemotron-3-super-120b-a12b:free  ~5s    质量好
#   nvidia/nemotron-3.5-lightning:free      ~6s    快但夹英文、结尾易失控
#   nvidia/nemotron-3-ultra-550b-a55b:free  ~22s   1M 上下文，输出最好（长文用）
#   poolside/laguna-s-2.1:free              ~7s    中英混杂，不建议中文
# 注意：免费档限流普遍，遇到 429/403 属常态（gemma-4 / inkling 实测即如此）。
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=apodex/apodex-1.1-mini:free
