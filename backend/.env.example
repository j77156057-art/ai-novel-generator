# 复制为 .env 后按需修改
#
# 默认走 SQLite：**零配置起步**，复制完就能起服务（空库会自动建表）。
DATABASE_URL=sqlite:///./novel_dev.db
#
# 要接 PostgreSQL + pgvector（生产/大数据量）：
#   1) docker compose up -d
#   2) pip install -r requirements-postgres.txt
#   3) 换成下面这行
# DATABASE_URL=postgresql+psycopg2://novel:novel@localhost:5432/novel
SEED_DIR=data/seed
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
UPLOAD_MAX_BYTES=20000000

# Embedding（M2 混合检索）。provider=dashscope 时需填 key；留空自动降级本地离线兜底
EMBEDDING_PROVIDER=dashscope
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM（M4 分段生成环）。provider=dashscope|openrouter|local；未配对应 key 自动降级本地离线兜底
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_BASE_URL=

# MiniMax（M3.1 系）的**思考深度** —— 写手专用。
# 官方档位：low / medium / high / xhigh / max（省略 = max，最慢最贵）。
# 思考关不掉（disabled/none → 400），只能调低。实测 effort=low：2400 字续写
# 66.7s → 36.0s，思考 token 2714 → 277，而且默认档写不出正文（预算被思考吃满、
# 正文被截断为空）。留空 = 不发该参数 = 官方默认（max）。
MINIMAX_REASONING_EFFORT=low

# OpenRouter（可选：免费模型）。用法：LLM_PROVIDER=openrouter 并填 OPENROUTER_API_KEY
# 默认关闭 reasoning（续写要吞吐）。2026-10 实测 15 款 :free，可用的按速度：
#   apodex/apodex-1.1-mini:free             ~2.5s  中文干净（默认，适合分段循环生成）
#   nvidia/nemotron-3-super-120b-a12b:free  ~5s    质量好
#   nvidia/nemotron-3.5-lightning:free      ~6s    快但夹英文、结尾易失控
#   nvidia/nemotron-3-ultra-550b-a55b:free  ~22s   1M 上下文，输出最好（长文用）
#   poolside/laguna-s-2.1:free              ~7s    中英混杂，不建议中文
# 注意：免费档限流普遍，遇到 429/403 属常态（gemma-4 / inkling 实测即如此）。
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=apodex/apodex-1.1-mini:free

# —— 对白形态的两个开关（候选池默认关；引导语补写**默认开**，它在主线路径上）——
#
# 候选池（Best-of-N）：同一提示采多份，**每份走完整条链之后**再用同一把尺量**成品**，
#   落库第一份合格的 ⇒「池选中 == 落库」。
#   1 = 关（默认）；≥2 = 候选份数。
#   ⚠️ 代价：采样与走链**交替**（采一份 → 走一条链 → 量一次 → 合格就停），
#      常态 = 1 次采样 + 1 条链；最坏 N 条链。实测（生产通道，N=3）：
#      第一份就合格 ⇒ 126.7 秒 / 2 次模型调用；都不合格 ⇒ 318.6 秒 / 48 次
#      / 3 条链。段长闸门在池内跑（走链之前），所以每一份候选都付一次闸门的钱。
STYLE_CANDIDATE_POOL=1
#
# 引导语补写：给**裸台词段**补一句动作/神态叙述（冒号形态），把它变成「叙述 + 台词同段」。
#   true = 开（**默认**）；false = 关。
#   为什么默认开：机械合并只改段落边界，实测只能把「纯台词段占比」从 71.5% 拉到 42.2%，
#      而参考书是 22.7% —— 关掉它，开箱即用的产物形态永远在带外。
#   什么时候真的会付钱：机械合并之后**裸台词多于带上沿 p90** 才触发（按需），
#      且只补到上沿就停（不追均值）+ 2 处余量 ⇒ 实测 5.6 次调用/段
#      （补到均值要 11.7 次），13 段真实正文全部进带。
#   ⚠️ 它**会新增文字**（机械合并不新增）⇒ 判据七道；还会多一道「说话人一致」
#      判据：模型自报说话人，服务端跟本段归属语、引导语自己的主语比对，判得死才拒。
STYLE_LEAD_IN=true
